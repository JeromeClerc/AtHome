# Copier en functions/.env.<project-id> (ou functions/.env) avant le déploiement.
# URL publique de l'application (Firebase Hosting ou domaine personnalisé), sans slash final.
APP_URL=https://votre-projet.web.app
# Région de déploiement (Zurich)
FUNCTIONS_REGION=europe-west6
# Clé API Gemini pour la fonction rewriteToBiff (en production : firebase functions:secrets:set GEMINI_API_KEY)
# GEMINI_API_KEY=votre-cle-gemini
