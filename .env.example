# Copier en .env.local et compléter avec la configuration Web de votre projet Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=votre-projet.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=votre-projet
VITE_FIREBASE_STORAGE_BUCKET=votre-projet.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Région des Cloud Functions (doit correspondre à functions/src)
VITE_FIREBASE_FUNCTIONS_REGION=europe-west6
# Cloud Messaging › Configuration Web › Certificats Web Push › « Paire de clés » (clé publique)
VITE_FIREBASE_VAPID_KEY=
# true = utiliser la Firebase Emulator Suite locale
VITE_USE_EMULATORS=false
